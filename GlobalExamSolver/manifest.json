{
  "manifest_version": 3,
  "name": "GlobalExam Solver",
  "version": "0.1.0",
  "description": "Automatise les réponses sur GlobalExam.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.global-exam.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.global-exam.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.global-exam.com/*"],
      "js": ["content.js", "data.js", "interactions.js", "solver.js", "ui.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GlobalExam Bot"
  }
}
